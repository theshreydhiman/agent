# ===========================================
# AI Influencer Agent - Environment Config
# Copy to .env and fill in your values
# ===========================================

# --- App ---
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-random-string

# --- Database ---
DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/influencer_agent
DATABASE_SYNC_URL=postgresql://agent:agent@localhost:5432/influencer_agent

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Instagram (Meta Graph API) ---
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# --- LLM (Ollama - local) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.3:70b

# --- Image Generation (ComfyUI) ---
COMFYUI_BASE_URL=http://localhost:8188
COMFYUI_OUTPUT_DIR=/output

# --- Video Generation (CogVideoX - local) ---
COGVIDEO_BASE_URL=http://localhost:8100

# --- Object Storage (MinIO / S3-compatible) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=influencer-media
S3_REGION=us-east-1

# --- Character Config ---
CHARACTER_NAME=Luna
CHARACTER_NICHE=lifestyle
CHARACTER_VOICE=friendly, witty, approachable

# --- Content Settings ---
POSTS_PER_WEEK=8
REELS_PER_WEEK=3
STORIES_PER_WEEK=5
POSTING_TIMEZONE=America/New_York

# --- Quality Thresholds ---
FACE_SIMILARITY_HARD_FLOOR=0.80
FACE_SIMILARITY_TARGET=0.85
FACE_SIMILARITY_GOAL=0.90
